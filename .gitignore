# ==========================================
# AetherVault Git Ignore Configuration
# Enforces strictly code-only repository
# No media, images, videos, audio, or binaries
# ==========================================

# Environment and Secrets
.env
.env*.local
*.pem
*.key

# Database and SQLite Wal Files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
backend/aethervault.db
backend/storage_vault/
backend/uploads/

# Images and Graphic Assets
*.png
*.jpg
*.jpeg
*.svg
*.webp
*.gif
*.bmp
*.ico
*.tiff
frontend/public/*.png
frontend/public/*.jpg
frontend/public/*.pdf
frontend/public/screenshots/

# Videos and Recordings
*.mp4
*.webm
*.mov
*.avi
*.mkv
*.flv
recordings/
scratch/recordings/

# Audio, Voices, and Voiceover Assets
*.wav
*.mp3
*.ogg
*.m4a
*.aac
*.flac
cleaned_voices/
voices/

# Speech Processing, Subtitles, and Recording Scripts
record_*.py
process_*.py
transcribe_*.py
dsp_audio.py
generate_subtitles.py
scratch_extract.py
test_rec.py
test_release_graph.py
extracted_sidebar.js
*.pdf
*.srt
*.ass
transcript_segments.json
title_slide.html
scratch/
tests/

# Python Compilation and Caching
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Node.js and Next.js Build Artifacts
node_modules/
.next/
out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tsbuildinfo

# OS and Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
.tempmediaStorage/
