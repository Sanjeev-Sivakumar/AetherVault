# AetherVault Environment Configuration Template
# Copy this file to .env and configure the values for your deployment

# Server Configuration
PORT=8000
HOST=127.0.0.1

# Database Configuration (defaults to SQLite if not specified)
# For SQLite: sqlite:///./aethervault.db
# For PostgreSQL: postgresql://postgres:password@localhost:5432/aethervault
DATABASE_URL=sqlite:///./aethervault.db

# Cryptographic and JWT Secrets
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
AES_STORAGE_KEY=0123456789abcdef0123456789abcdef

# n8n Automation Engine Bridge
N8N_ENGINE_URL=http://127.0.0.1:5678
N8N_SECRET_TOKEN=aethervault-n8n-webhook-secret-token-2026

# Multimodal Document Intelligence / VDU Engine (Optional)
# If provided, enables enhanced zero-shot multimodal scrutiny
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.5-flash
ENABLE_GEMINI_OCR=false

# SMTP Notification Gateway (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=your-email@example.com
